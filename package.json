{
  "name": "chessapp-analyze-v1",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && yarn build:prerender",
    "build:prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "wirepgn": "node scripts/wirepgn.js",
    "theme:bootstrap": "node scripts/theme-bootstrap.js",
    "mdx-editor:start": "node src/mdxEditor/server/start.ts",
    "api:start": "bash server/engine-api/start.sh start",
    "api:test": "bash server/engine-api/start.sh test",
    "test": "vitest --project unit --project ui",
    "test:run": "vitest run --project unit --project ui",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:gallery": "vitest run --project gallery",
    "test:groups": "node scripts/check-test-groups.js",
    "check:blog-build": "node scripts/check-dist-blog.js",
    "check:pages": "node scripts/check-dist-pages.js",
    "test:a11y": "yarn build && playwright test",
    "test:a11y:quick": "yarn build && A11Y_MATRIX=reduced playwright test"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^9.4.0",
    "@xstate/react": "^6.1.0",
    "chess.js": "^1.4.0",
    "fflate": "^0.8.3",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.1",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1",
    "remark-frontmatter": "^5.0.0",
    "xstate": "^5.32.6",
    "yaml": "^2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/server": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
